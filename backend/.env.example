# Django Core
SECRET_KEY=django-insecure-commercepilot-production-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL URL e.g. for Neon / Render, leave empty for local SQLite)
DATABASE_URL=postgres://commercepilot:password@localhost:5432/commercepilot

# AI Integration (Optional: Google Gemini API key or OpenAI key)
# If left empty, CommercePilot automatically utilizes its built-in catalog semantic heuristics engine!
GEMINI_API_KEY=
OPENAI_API_KEY=
